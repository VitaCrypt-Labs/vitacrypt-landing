<style>
.sub{margin-top:28px;font-size:20px}
.sub .tag{font:500 12px/1 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--dim);border:1px solid var(--line);border-radius:6px;padding:4px 6px;margin-left:6px;vertical-align:2px}
.pils{grid-template-columns:repeat(2,minmax(0,1fr))}
@media (min-width:900px){.pils{grid-template-columns:repeat(4,minmax(0,1fr))}}
.pil{display:grid;gap:8px;text-decoration:none;min-height:44px;height:100%}
.tile .sq{margin-bottom:10px}
.tile h3+p{margin-top:6px}
.rail .st{display:flex;flex-wrap:wrap;gap:12px 20px;align-items:flex-start}
.rail .st{flex-wrap:nowrap}
.rail .st>div{flex:1 1 auto}
.rail .st h3{font-size:20px}
.rail .st img{display:none}
@media (min-width:900px){.rail .st img{display:block;flex:0 0 auto;width:220px;height:auto;border:1px solid var(--line);border-radius:10px}}
.rail>li{padding:16px 0}
.rail>li:not(:last-child)::after{top:62px;bottom:-16px}
.chips{list-style:none;padding:0}
ul.chips li.chip{min-height:28px}
.ex{margin-top:20px;display:grid;gap:10px}
.tile .mono{margin:0}
.tile.wk{display:grid;gap:8px;align-content:start}
.pay{display:flex;flex-wrap:wrap;gap:6px}
.pay span{font-size:12px;border:1px solid var(--line);border-radius:999px;padding:4px 10px;color:var(--dim)}
.rows.g2{margin-top:12px}
.tr .rows{margin-top:12px}
p.cap a,.close .cap a{color:var(--ink)}
.fails{grid-template-columns:repeat(2,minmax(0,1fr))}@media (min-width:900px){.fails{grid-template-columns:repeat(4,minmax(0,1fr))}}
.flow3{grid-template-columns:repeat(3,minmax(0,1fr))}.flow3 .tile{padding:12px}.flow3 .sq{width:32px;height:32px}
