<style>
:root {
  --bg: #070B1F;
  --bg-2: #0B1230;
  --surface: #121A3F;
  --surface-2: #1A2350;
  --line: #232C5E;
  --line-soft: #1A2350;
  --ink: #F5F3EE;
  --ink-2: #D9D6CD;
  --ink-mute: #95A0CC;
  --ink-faint: #515A86;
  --teal: #6B8AFF;
  --teal-deep: #3B5BFF;
  --teal-glow: rgba(107, 138, 255, 0.20);
  --amber: #FFC58A;
  --rose: #FF7B6B;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { background: var(--bg); scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--ink);
  font-family: 'Geist', -apple-system, sans-serif;
  font-size: 16px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}
body::before {
  content: '';
  position: fixed; inset: 0;
  background: radial-gradient(ellipse 900px 600px at 25% 0%, var(--teal-glow), transparent 60%);
  pointer-events: none; z-index: 0;
}
.mono { font-family: 'Geist Mono', monospace; }
.serif { font-family: 'Instrument Serif', serif; font-style: italic; }

a { color: var(--teal); text-decoration: none; }
a:hover { text-decoration: underline; text-underline-offset: 3px; }

.wrap { max-width: 780px; margin: 0 auto; padding: 0 32px; position: relative; z-index: 1; }
.wrap-wide { max-width: 1080px; margin: 0 auto; padding: 0 32px; position: relative; z-index: 1; }

/* NAV */
nav.top {
  position: sticky; top: 0; z-index: 50;
  background: color-mix(in srgb, var(--bg) 82%, transparent);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
}
nav.top .inner {
  max-width: 1280px; margin: 0 auto; padding: 0 32px;
  display: flex; justify-content: space-between; align-items: center;
  height: 60px;
}
nav.top .brand { display: flex; align-items: center; gap: 10px; }
nav.top .brand img { width: 26px; height: 26px; border-radius: 6px; object-fit: cover; }
nav.top .brand .word { font-weight: 600; font-size: 15px; letter-spacing: -0.015em; }
nav.top .brand .tag {
  font-family: 'Geist Mono', monospace; font-size: 10px;
  letter-spacing: 0.12em; color: var(--ink-faint); text-transform: uppercase;
  padding: 3px 7px; border: 1px solid var(--line); border-radius: 4px;
  margin-left: 6px;
}
nav.top .toc { display: flex; gap: 6px; }
nav.top .toc a {
  font-family: 'Geist Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.06em;
  padding: 6px 10px;
  border-radius: 6px;
  color: var(--ink-mute);
  transition: all 0.15s;
}
nav.top .toc a:hover { color: var(--ink); background: var(--surface); text-decoration: none; }
nav.top .back {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 14px; border-radius: 999px;
  background: var(--surface); border: 1px solid var(--line);
  font-size: 12.5px; color: var(--ink-mute); transition: all 0.2s;
}
nav.top .back:hover { color: var(--ink); border-color: var(--ink-faint); text-decoration: none; }
@media (max-width: 900px) {
  nav.top .toc {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-top: 1px solid var(--line);
    padding: 8px 10px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    z-index: 70;
    gap: 2px;
  }
  nav.top .toc::-webkit-scrollbar { display: none; }
  nav.top .toc a {
    flex: 0 0 auto;
    scroll-snap-align: start;
    white-space: nowrap;
  }
  body { padding-bottom: 56px; }
}

/* DOC HEAD */
.doc-head {
  padding: 72px 0 56px;
  border-bottom: 1px solid var(--line);
}
.doc-meta {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 18px; margin-bottom: 36px;
}
.doc-meta .item { border-left: 2px solid var(--teal); padding-left: 12px; }
.doc-meta .item .k {
  font-family: 'Geist Mono', monospace;
  font-size: 10px; letter-spacing: 0.12em;
  color: var(--ink-faint); text-transform: uppercase;
  margin-bottom: 4px;
}
.doc-meta .item .v {
  font-size: 12px; color: var(--ink); font-weight: 500;
  letter-spacing: -0.005em;
}
@media (max-width: 768px) { .doc-meta { grid-template-columns: 1fr 1fr; } }

.doc-head h1 {
  font-size: clamp(34px, 5vw, 56px);
  line-height: 1.04;
  letter-spacing: -0.035em;
  font-weight: 500;
  margin-bottom: 22px;
  max-width: 22ch;
}
.doc-head h1 .ac {
  color: var(--teal);
  font-family: 'Instrument Serif', serif;
  font-style: italic; font-weight: 400;
}
.doc-head .standfirst {
  font-size: 18px; color: var(--ink-mute);
  line-height: 1.55; max-width: 60ch;
  margin-bottom: 28px;
}
.doc-head .standfirst strong { color: var(--ink); font-weight: 500; }
.doc-head .byline {
  font-family: 'Geist Mono', monospace;
  font-size: 11px; letter-spacing: 0.1em;
  color: var(--ink-faint); text-transform: uppercase;
  padding-top: 18px; border-top: 1px solid var(--line);
  display: flex; gap: 18px; flex-wrap: wrap;
}
.doc-head .byline strong { color: var(--ink); font-weight: 500; }

/* SECTION */
section {
  padding: 56px 0;
  border-bottom: 1px solid var(--line-soft);
}
@media (max-width: 768px) { section { padding: 44px 0; } }
@media (max-width: 480px) {
  section { padding: 36px 0; }
  h2, p, li { overflow-wrap: break-word; word-break: normal; }
}

/* A11Y: REDUCED MOTION */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}
.section-id {
  font-family: 'Geist Mono', monospace;
  font-size: 11px; letter-spacing: 0.12em;
  color: var(--teal); text-transform: uppercase;
  margin-bottom: 18px;
  display: flex; gap: 14px; align-items: baseline;
}
.section-id .num { color: var(--ink-faint); }
h2 {
  font-size: clamp(26px, 3.4vw, 36px);
  line-height: 1.1; letter-spacing: -0.03em;
  font-weight: 500; margin-bottom: 24px;
  max-width: 26ch;
}
h2 .ac {
  color: var(--teal); font-family: 'Instrument Serif', serif;
  font-style: italic; font-weight: 400;
}
h3 {
  font-size: 17px; font-weight: 500;
  letter-spacing: -0.01em; margin: 28px 0 10px;
  color: var(--ink);
}
h4 {
  font-family: 'Geist Mono', monospace;
  font-size: 11px; font-weight: 600;
  letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--teal); margin-bottom: 8px;
}
p {
  color: var(--ink-2);
  font-size: 16px; line-height: 1.7;
  margin-bottom: 14px; max-width: 68ch;
}
p strong { color: var(--ink); font-weight: 500; }
p code, li code {
  font-family: 'Geist Mono', monospace;
  font-size: 13.5px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 4px;
  padding: 1px 6px;
  color: var(--teal);
}
ul, ol { margin-bottom: 16px; padding-left: 22px; max-width: 68ch; }
li { color: var(--ink-2); font-size: 15.5px; line-height: 1.7; margin-bottom: 5px; }
li strong { color: var(--ink); font-weight: 500; }

/* BLOCKS */
.kvs {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 12px; margin: 18px 0;
}
.kv {
  background: var(--surface); border: 1px solid var(--line);
  border-radius: 10px; padding: 14px 16px;
}
.kv .k {
  font-family: 'Geist Mono', monospace;
  font-size: 10px; letter-spacing: 0.1em;
  color: var(--ink-faint); text-transform: uppercase;
  margin-bottom: 6px;
}
.kv .v { font-size: 14px; color: var(--ink); line-height: 1.5; }
.kv .v strong { font-weight: 500; }
.kv .v code { font-size: 12px; color: var(--teal); }
@media (max-width: 600px) { .kvs { grid-template-columns: 1fr; } }

.note {
  background: var(--surface); border: 1px solid var(--line);
  border-left: 2px solid var(--teal);
  padding: 16px 22px; border-radius: 0 8px 8px 0;
  margin: 18px 0;
}
.note .lbl {
  font-family: 'Geist Mono', monospace;
  font-size: 10px; letter-spacing: 0.12em;
  color: var(--teal); text-transform: uppercase;
  margin-bottom: 6px;
}
.note p { margin-bottom: 0; color: var(--ink-2); font-size: 14.5px; }
.note.warn { border-left-color: var(--amber); }
.note.warn .lbl { color: var(--amber); }
.note.warn p { color: var(--ink-2); }

.code-block {
  background: var(--bg-2);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 16px 18px;
  font-family: 'Geist Mono', monospace;
  font-size: 13px;
  line-height: 1.6;
  color: var(--ink-2);
  overflow-x: auto;
  margin: 18px 0;
  white-space: pre;
}
.code-block .kw { color: var(--teal); }
.code-block .cm { color: var(--ink-faint); font-style: italic; }
.code-block .str { color: var(--amber); }
.code-block .num { color: var(--rose); }

/* TABLE */
.spec-table {
  width: 100%;
  border-collapse: collapse;
  margin: 18px 0;
  font-size: 14px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 10px;
  overflow: hidden;
}
.spec-table th, .spec-table td {
  text-align: left;
  padding: 12px 16px;
  border-bottom: 1px solid var(--line);
  vertical-align: top;
}
.spec-table th {
  font-family: 'Geist Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-faint);
  background: var(--bg-2);
  font-weight: 600;
}
.spec-table tr:last-child td { border-bottom: none; }
.spec-table td.c1 { font-weight: 500; color: var(--ink); width: 26%; }
.spec-table td code { font-family: 'Geist Mono', monospace; font-size: 12px; color: var(--teal); }
.spec-table .badge {
  display: inline-block;
  font-family: 'Geist Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.08em;
  padding: 2px 7px;
  border-radius: 999px;
  text-transform: uppercase;
}
.spec-table .badge.live { background: var(--teal-glow); color: var(--teal); border: 1px solid var(--teal-deep); }
.spec-table .badge.q { background: rgba(255, 197, 138, 0.12); color: var(--amber); border: 1px solid rgba(255, 197, 138, 0.3); }
.spec-table .badge.no { background: rgba(255, 123, 107, 0.10); color: var(--rose); border: 1px solid rgba(255, 123, 107, 0.3); }
@media (max-width: 768px) {
  .spec-table { font-size: 13px; }
  .spec-table th, .spec-table td { padding: 10px 12px; }
}

/* OPEN QS */
.openq-list {
  display: flex; flex-direction: column;
  gap: 10px; margin: 20px 0;
}
.openq {
  background: var(--surface); border: 1px solid var(--line);
  border-radius: 10px;
  padding: 16px 20px;
  display: grid; grid-template-columns: 56px 1fr; gap: 16px;
  align-items: start;
}
.openq .ix {
  font-family: 'Geist Mono', monospace;
  font-size: 11px; letter-spacing: 0.1em;
  color: var(--amber); text-transform: uppercase;
  font-weight: 600;
  padding-top: 2px;
}
.openq .q {
  font-size: 15px;
  color: var(--ink);
  font-weight: 500;
  line-height: 1.45;
  margin-bottom: 4px;
}
.openq .why {
  font-size: 13.5px;
  color: var(--ink-mute);
  line-height: 1.55;
}

/* DIAGRAM */
.flow {
  background: var(--surface); border: 1px solid var(--line);
  border-radius: 14px;
  padding: 24px 18px;
  margin: 22px 0;
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr;
  gap: 12px;
  align-items: center;
}
@media (max-width: 800px) { .flow { grid-template-columns: 1fr; gap: 16px; } .flow .arr { display: none; } }
.flow .node {
  border: 1px solid var(--line);
  background: var(--bg-2);
  border-radius: 10px;
  padding: 16px 14px;
  text-align: center;
}
.flow .node.us { border-color: var(--teal-deep); background: linear-gradient(180deg, color-mix(in srgb, var(--teal-glow) 50%, var(--bg-2)), var(--bg-2)); }
.flow .node .ttl {
  font-family: 'Geist Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
  color: var(--ink-faint);
  text-transform: uppercase;
  margin-bottom: 6px;
}
.flow .node.us .ttl { color: var(--teal); }
.flow .node .body {
  font-size: 13.5px;
  color: var(--ink);
  line-height: 1.45;
  font-weight: 500;
}
.flow .node .meta {
  margin-top: 8px;
  font-family: 'Geist Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
  color: var(--ink-faint);
  text-transform: uppercase;
}
.flow .arr {
  font-family: 'Geist Mono', monospace;
  color: var(--teal);
  font-size: 13px;
  text-align: center;
}
.flow .arr .lbl {
  font-size: 9px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-faint);
  display: block;
  margin-bottom: 2px;
}

/* CTA */
.cta-block {
  background: var(--surface); border: 1px solid var(--line);
  border-radius: 14px; padding: 32px;
  margin: 32px 0; text-align: center;
}
.cta-block h3 {
  font-size: 22px; font-weight: 500;
  letter-spacing: -0.02em; margin: 0 0 10px;
  color: var(--ink);
}
.cta-block p { font-size: 14.5px; max-width: 52ch; margin: 0 auto 22px; }
.cta-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 13px 22px; border-radius: 999px;
  background: var(--teal); color: #02110D;
  font-weight: 500; font-size: 14px;
  text-decoration: none;
  box-shadow: 0 14px 32px -10px var(--teal-glow);
  transition: all 0.2s;
}
.cta-btn:hover { transform: translateY(-1px); text-decoration: none; }

/* REFS */
.refs { padding-top: 8px; }
.refs li {
  font-family: 'Geist Mono', monospace;
  font-size: 12px;
  color: var(--ink-mute);
  margin-bottom: 8px;
  line-height: 1.55;
}
.refs li strong { color: var(--ink); font-weight: 500; font-family: 'Geist Mono', monospace; }
.refs li em { color: var(--amber); font-style: normal; }

footer {
  padding: 40px 0 32px;
  font-family: 'Geist Mono', monospace;
  font-size: 10px; letter-spacing: 0.1em;
  color: var(--ink-faint); text-transform: uppercase;
  text-align: center;
}
</style>
</head>
