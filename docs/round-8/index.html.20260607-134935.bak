<meta name="theme-color" content="#06080C">
<meta name="color-scheme" content="dark light">

<!-- Primary SEO -->
<title>VitaCrypt · Your whole health in one intelligent profile</title>
<meta name="description" content="VitaCrypt unifies genetics, wearables, labs, microbiome, environment and lifestyle into one profile with actionable, evidence-checked guidance. Private by design.">
