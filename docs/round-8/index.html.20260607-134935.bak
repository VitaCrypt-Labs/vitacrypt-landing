<!-- ========== MOBILE STICKY SECTION NAV ========== -->
<nav class="mob-secnav" aria-label="Sections">
  <button data-target="thesis" aria-label="Thesis">01</button>
  <button data-target="fabric" aria-label="The data fabric">02</button>
  <button data-target="research" aria-label="Live science">03</button>
  <button data-target="pipeline" aria-label="The architecture">04</button>
  <button data-target="diff" aria-label="Versus the field">05</button>
  <button data-target="case" aria-label="Case study">06</button>
  <button data-target="insights" aria-label="A week in the protocol">07</button>
  <button data-target="roadmap" aria-label="Trajectory">08</button>
  <button data-target="why" aria-label="Why now">09</button>
  <button class="mob-secnav-menu" data-action="open-drawer" aria-label="Open menu">
    <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
      <line x1="0" y1="1" x2="16" y2="1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <line x1="0" y1="6" x2="16" y2="6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <line x1="0" y1="11" x2="16" y2="11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </button>
</nav>

<!-- ========== WAITLIST FORM MODAL ========== -->
<div class="form-modal" id="waitlistModal" role="dialog" aria-modal="true" aria-labelledby="formTitle" aria-hidden="true">
  <div class="form-backdrop" id="formBackdrop"></div>
  <form class="form-card" id="waitlistForm" novalidate>
    <header class="form-head">
      <div>
        <span class="form-eyebrow">VitaCrypt access</span>
        <h3 id="formTitle">Join the waitlist</h3>
      </div>
      <button type="button" class="form-close" id="formClose" aria-label="Close form">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <line x1="1" y1="1" x2="13" y2="13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <line x1="13" y1="1" x2="1" y2="13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </header>
    <p class="form-intro">Tell us who you are. We respond within 48 hours.</p>
    <div class="form-fields">
      <label class="form-field">
        <span class="form-label">Name</span>
        <input name="name" type="text" required maxlength="100" autocomplete="name" placeholder="Your full name">
      </label>
      <label class="form-field">
        <span class="form-label">Email</span>
        <input name="email" type="email" required maxlength="200" autocomplete="email" placeholder="you@domain.com">
      </label>
      <label class="form-field">
        <span class="form-label">I am a…</span>
        <select name="audience" required>
          <option value="" disabled selected>Select your role</option>
          <option value="investor">Investor</option>
          <option value="user">User / patient</option>
          <option value="press">Press / journalist</option>
          <option value="partner">Partner (lab / clinic / academic)</option>
        </select>
      </label>
      <label class="form-field">
        <span class="form-label">Message <span class="form-optional">(optional)</span></span>
        <textarea name="message" maxlength="500" rows="3" placeholder="What brings you here?"></textarea>
      </label>
      <label class="form-consent">
        <input name="consent" type="checkbox" required>
        <span>I consent to VitaCrypt receiving and reviewing this message. We do not share, sell, or store it beyond our internal review.</span>
      </label>
      <input type="text" name="company" tabindex="-1" autocomplete="off" class="form-honey" aria-hidden="true">
    </div>
    <button type="submit" class="btn btn-glow form-submit" id="formSubmit">
      Send
      <svg class="arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <p class="form-status" id="formStatus" aria-live="polite"></p>
    <p class="form-fallback">Prefer email? <a href="mailto:marketing@vitacrypt.xyz">marketing@vitacrypt.xyz</a></p>
  </form>
</div>

<script>
// ====================== GLOBAL UTILS (commit 4C) ======================
const HEX = '0123456789ABCDEF';
const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
function randHex(){ return HEX[Math.floor(Math.random()*16)]; }

// THEME (single handler; optional "re-encrypt" scramble overlay when motion allowed)
const root = document.documentElement;
const tBtn = document.getElementById('themeToggle');
const stored = localStorage.getItem('vc-theme-d');
if (stored) { root.setAttribute('data-theme', stored); }
else if (window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches) { root.setAttribute('data-theme', 'light'); }
function syncThemeColor(t){ const m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute('content', t === 'light' ? '#F4EFE5' : '#06080C'); }
syncThemeColor(root.getAttribute('data-theme'));
let themeOverlay = null;
function setTheme(next){ root.setAttribute('data-theme', next); localStorage.setItem('vc-theme-d', next); syncThemeColor(next); }
function toggleTheme(){
  const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
  if (RM) { setTheme(next); return; }
  if (!themeOverlay){
    themeOverlay = document.createElement('div');
    themeOverlay.className = 'theme-scramble-overlay';
    themeOverlay.setAttribute('aria-hidden', 'true');
    document.body.appendChild(themeOverlay);
  }
  themeOverlay.classList.add('show');
  let n = 0;
  const id = setInterval(() => {
    n++;
    themeOverlay.textContent = 're-encrypting view ' + Array.from({length:12}, randHex).join('');
    if (n === 8) setTheme(next);
    if (n > 16) { clearInterval(id); themeOverlay.classList.remove('show'); }
  }, 32);
}
tBtn.addEventListener('click', toggleTheme);

// PIPELINE STAGES
const stages = [
  {
    headLabel: 'STAGE 01 / COLLECT',
    tagBox: '01', tagText: 'COLLECT',
    title: 'A unified profile, drawn from every source.',
    summary: 'Wearables (via Terra API), DNA, microbiome, labs, environment, and PROMIS surveys ingest on-device into a single living profile. <strong>Nothing has left the device yet.</strong>',
    what: [
      'Upload 23andMe / AncestryDNA reports',
      'Connect Apple Watch or Oura ring',
      'Pull air quality + UV from your location'
    ],
    arch: { left: 'active', center: '', right: '', arrow1: '', arrow2: '' },
    archKeys: { left: '🔑 KEY · ON DEVICE', mid: 'LOCAL · NOT TRANSMITTED', right: '🔑 KEY · ON DEVICE' },
    phoneStage: '01 · Collect · Local',
    phoneCaption: 'Sources sync locally. Nothing has been transmitted.',
    phoneCards: [
      { lbl: 'DNA · MTHFR C677T', v: 'TT', cls: '' },
      { lbl: 'WEARABLE · HRV 3d', v: '38 ms', cls: '' },
      { lbl: 'ENVIRONMENT · LA', v: '52 μg/m³ PM2.5', cls: '' },
      { lbl: 'LABS · CRP', v: '3.2 mg/L', cls: '' }
    ]
  },
  {
    headLabel: 'STAGE 02 / ENCRYPT',
    tagBox: '02', tagText: 'ENCRYPT',
    title: 'Your phone encrypts it.',
    summary: 'Signals are encrypted with your key into TFHE ciphertext. By design, the <strong>key never leaves your device</strong>, and the encrypted form is what travels.',
    what: [
      'TFHE encryption on-device with your key',
      'Encrypted payload uploaded to compute',
      'Built so plaintext is never retained server-side'
    ],
    arch: { left: 'active', center: '', right: '', arrow1: 'active', arrow2: '' },
    archKeys: { left: '🔑 KEY · ON DEVICE', mid: 'CIPHERTEXT IN FLIGHT', right: '🔑 KEY · ON DEVICE' },
    phoneStage: '02 · Encrypt · On device',
    phoneCaption: 'Each signal converts to ciphertext. By design, your key stays here.',
    phoneCards: [
      { lbl: 'DNA · encrypted', v: 'enc("0x9af3…7e88")', cls: 'encrypted' },
      { lbl: 'WEARABLE · encrypted', v: 'enc("0xf270…b91d")', cls: 'encrypted' },
      { lbl: 'ENVIRONMENT · encrypted', v: 'enc("0x1c44…2009")', cls: 'encrypted' },
      { lbl: 'LABS · encrypted', v: 'enc("0x8b1e…4a02")', cls: 'encrypted' }
    ]
  },
  {
    headLabel: 'STAGE 03 / COMPUTE',
    tagBox: '03', tagText: 'COMPUTE',
    title: 'The server runs models on ciphertext.',
    summary: 'AI models on Zama Concrete ML are built to run <strong>directly on encrypted data</strong>, surfacing patterns without seeing inputs. Proven today on one encrypted genetic vector; scaling across the pipeline.',
    what: [
      'Concrete ML inference on TFHE ciphertext',
      'Target: no decryption at any compute step',
      'Server computes on ciphertext, not plaintext'
    ],
    arch: { left: '', center: 'active', right: '', arrow1: '', arrow2: '' },
    archKeys: { left: '🔑 KEY · ON DEVICE', mid: 'COMPUTING ON CIPHERTEXT', right: '🔑 KEY · ON DEVICE' },
    phoneStage: '03 · Compute · Remote',
    phoneCaption: 'The server computes on ciphertext, by design.',
    phoneCards: [
      { lbl: 'STATE', v: 'Running FHE inference…', cls: 'encrypted' },
      { lbl: 'LATENCY', v: '~5 minutes', cls: 'encrypted' },
      { lbl: 'OPS', v: '4,812 enc gates', cls: 'encrypted' },
      { lbl: 'SERVER VIEW', v: 'enc("0x????…????")', cls: 'encrypted' }
    ]
  },
  {
    headLabel: 'STAGE 04 / ACT',
    tagBox: '04', tagText: 'ACT',
    title: 'Your phone decrypts and tells you what to do.',
    summary: 'Encrypted output returns to your device. Only your key can open it. The output is not a dashboard, it is <strong>a small, ordered list of actions</strong>, cited to peer-reviewed literature.',
    what: [
      'Encrypted result returned to your phone',
      'Decrypted locally with your key',
      'Cross-referenced to PubMed + Cochrane'
    ],
    arch: { left: '', center: '', right: 'active', arrow1: '', arrow2: 'active' },
    archKeys: { left: '🔑 KEY · ON DEVICE', mid: 'CIPHERTEXT RETURN', right: '🔑 KEY · DECRYPTS' },
    phoneStage: '04 · Act · On device',
    phoneCaption: 'You see plain language. By design, the server worked on ciphertext.',
    phoneCards: [
      { lbl: 'INSIGHT', v: 'Inflammatory pressure detected', cls: 'glow', t: 'Inflammatory pressure detected', b: 'Your MTHFR × PM2.5 × HRV decline indicates sustained low-grade inflammation. <span class="em-teal">Methylated folate + HEPA + zone-2 cardio.</span>' },
      { lbl: 'ACTION', v: '3 today · 4 weekly', cls: '' },
      { lbl: 'CITES', v: 'PubMed +4 · Cochrane +1', cls: '' }
    ]
  }
];

const pipeButtons = document.querySelectorAll('.pipe-tabs button');
const headLabel = document.getElementById('pipeHeadLabel');
const tagBox = document.getElementById('stTagBox');
const tagText = document.getElementById('stTagText');
const stTitle = document.getElementById('stTitle');
const stSummary = document.getElementById('stSummary');
const stWhatList = document.getElementById('stWhatList');
const archLeft = document.getElementById('archLeft');
const archCenter = document.getElementById('archCenter');
const archRight = document.getElementById('archRight');
const archArrow1 = document.getElementById('archArrow1');
const archArrow2 = document.getElementById('archArrow2');
const archKeyLeft = document.getElementById('archKeyLeft');
const archKeyMid = document.getElementById('archKeyMiddle');
const archKeyRight = document.getElementById('archKeyRight');
const phoneStage = document.getElementById('phoneStage');
const phoneCaption = document.getElementById('phoneCaption');
const phoneBody = document.getElementById('phoneBody');

function applyStage(i) {
  const s = stages[i];
  headLabel.textContent = s.headLabel;
  tagBox.textContent = s.tagBox;
  tagText.textContent = s.tagText;
  stTitle.textContent = s.title;
  stSummary.innerHTML = s.summary;
  stWhatList.innerHTML = s.what.map(w => '<li>' + w + '</li>').join('');

  // Architecture node states
  [archLeft, archCenter, archRight].forEach(n => n.classList.remove('active'));
  [archArrow1, archArrow2].forEach(a => a.classList.remove('active'));
  archLeft.querySelector('.frame').classList.remove('active');
  archCenter.querySelector('.frame').classList.remove('active');
  archRight.querySelector('.frame').classList.remove('active');

  if (s.arch.left) {
    archLeft.classList.add('active');
    archLeft.querySelector('.frame').classList.add('active');
  }
  if (s.arch.center) {
    archCenter.classList.add('active');
    archCenter.querySelector('.frame').classList.add('active');
  }
  if (s.arch.right) {
    archRight.classList.add('active');
    archRight.querySelector('.frame').classList.add('active');
  }
  if (s.arch.arrow1) archArrow1.classList.add('active');
  if (s.arch.arrow2) archArrow2.classList.add('active');

  archKeyLeft.textContent = s.archKeys.left;
  archKeyMid.textContent = s.archKeys.mid;
  archKeyRight.textContent = s.archKeys.right;

  // Phone state
  phoneStage.textContent = s.phoneStage;
  phoneCaption.textContent = s.phoneCaption;
  phoneBody.innerHTML = s.phoneCards.map(c => {
    if (c.t) {
      return '<div class="mini-card ' + c.cls + '"><div class="lbl">' + c.lbl + '</div><div class="insight-t">' + c.t + '</div><div class="insight-b">' + c.b + '</div></div>';
    }
    return '<div class="mini-card ' + c.cls + '"><div class="lbl">' + c.lbl + '</div><div class="v">' + c.v + '</div></div>';
  }).join('');

  // Active button
  pipeButtons.forEach((b, idx) => b.classList.toggle('active', idx === i));
}

pipeButtons.forEach((b, i) => b.addEventListener('click', () => {
  clearInterval(autoplay);
  applyStage(i);
}));

let cur = 0;
let autoplay = null;
function startAutoplay() {
  if (RM) return;  // honor prefers-reduced-motion (manual tab control only)
  autoplay = setInterval(() => {
    cur = (cur + 1) % stages.length;
    applyStage(cur);
  }, 4500);
}

// Init
applyStage(0);

// Start autoplay when pipeline is visible, pause when offscreen (perf)
const pipeObs = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting && !autoplay) {
      startAutoplay();
    } else if (!e.isIntersecting && autoplay) {
      clearInterval(autoplay);
      autoplay = null;
    }
  });
}, { threshold: 0.3 });
pipeObs.observe(document.getElementById('pipeline'));

// Reveal on scroll — extended with A3 scanline + A7 odometer (commit 4C)
const revealObs = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('in');
      revealObs.unobserve(e.target);
      // A3: one-shot decryption scanline
      if (!RM && !e.target.dataset.swept) {
        e.target.dataset.swept = '1';
        e.target.classList.add('decrypt-sweep');
        setTimeout(() => e.target.classList.remove('decrypt-sweep'), 1300);
      }
    }
  });
}, { threshold: 0.12 });
document.querySelectorAll('section, .facts, .case-wrap').forEach(el => {
  el.classList.add('reveal');
  revealObs.observe(el);
});

// HERO PROFILE — animate source bars when in view
const heroProfile = document.getElementById('heroProfile');
if (heroProfile) {
  const heroObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        heroProfile.classList.add('in');
        heroObs.disconnect();
      }
    });
  }, { threshold: 0.2 });
  heroObs.observe(heroProfile);
}

// HERO CIPHER — live mutate hex chars, paused when offscreen or tab hidden (perf)
(function cipherLoop(){
  if (RM) return;  // honor prefers-reduced-motion (no text churn)
  const stream = document.getElementById('cipherStream');
  if (!stream) return;
  const cipherCard = stream.closest('.hero-card.cipher') || stream;
  const HEX = '0123456789ABCDEF';
  const rows = Array.from(stream.querySelectorAll('.row'));
  let timer = null;
  let inView = false;

  function mutate(){
    const row = rows[Math.floor(Math.random() * rows.length)];
    if (!row) return;
    const text = row.textContent.split('');
    const targets = new Set();
    let safety = 0;
    while (targets.size < 3 && safety++ < 30) {
      const i = Math.floor(Math.random() * text.length);
      if (/[0-9A-Fa-f]/.test(text[i])) targets.add(i);
    }
    targets.forEach(i => { text[i] = HEX[Math.floor(Math.random()*16)]; });
    row.textContent = text.join('');
    rows.forEach(r => r.classList.remove('flash'));
    row.classList.add('flash');
  }
  function start(){
    if (timer || !inView || document.hidden) return;
    cipherCard.classList.add('cs-active');
    timer = setInterval(mutate, 320);
  }
  function stop(){
    if (!timer) return;
    clearInterval(timer);
    timer = null;
    cipherCard.classList.remove('cs-active');
  }
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { inView = e.isIntersecting; inView ? start() : stop(); });
  }, { threshold: 0.1 });
  obs.observe(cipherCard);
  document.addEventListener('visibilitychange', () => { document.hidden ? stop() : start(); });
})();

// ====================== MOBILE UI (commit 4B) ======================
(function mobileUI(){
  const MOBILE_MQ = window.matchMedia('(max-width: 768px)');
  const PIPE_AUTOPLAY_PAUSE_MS = 8000;

  // 5A.2: Hamburger drawer
  const burger = document.getElementById('burgerBtn');
  const drawer = document.getElementById('mobileDrawer');
  const backdrop = document.getElementById('drawerBackdrop');
  const drawerClose = document.getElementById('drawerClose');
  const drawerThemeToggle = document.getElementById('drawerThemeToggle');
  const drawerLinks = document.querySelectorAll('[data-drawer-link]');

  if (burger && drawer && backdrop) {
    let prevFocus = null;

    function getFocusable() {
      return drawer.querySelectorAll('a, button, [tabindex]:not([tabindex="-1"])');
    }
    function openDrawer() {
      prevFocus = document.activeElement;
      drawer.classList.add('open');
      backdrop.classList.add('open');
      document.body.classList.add('drawer-open');
      burger.setAttribute('aria-expanded', 'true');
      drawer.setAttribute('aria-hidden', 'false');
      backdrop.setAttribute('aria-hidden', 'false');
      // focus first focusable element
      const focusables = getFocusable();
      if (focusables.length) setTimeout(() => focusables[0].focus(), 100);
    }
    function closeDrawer() {
      drawer.classList.remove('open');
      backdrop.classList.remove('open');
      document.body.classList.remove('drawer-open');
      burger.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('aria-hidden', 'true');
      backdrop.setAttribute('aria-hidden', 'true');
      if (prevFocus && prevFocus.focus) prevFocus.focus();
    }

    burger.addEventListener('click', openDrawer);
    drawerClose.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);
    drawerLinks.forEach(a => a.addEventListener('click', closeDrawer));

    // Esc to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('open')) closeDrawer();
    });

    // Focus trap
    drawer.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !drawer.classList.contains('open')) return;
      const focusables = Array.from(getFocusable());
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    // Drawer theme toggle reuses main toggle
    if (drawerThemeToggle && tBtn) {
      drawerThemeToggle.addEventListener('click', () => tBtn.click());
    }

    // 5A.5: bottom sticky-nav hamburger opens drawer
    document.querySelectorAll('[data-action="open-drawer"]').forEach(b => {
      b.addEventListener('click', (e) => { e.preventDefault(); openDrawer(); });
    });
  }

  // 5A.4: Waitlist form modal
  const modal = document.getElementById('waitlistModal');
  const form = document.getElementById('waitlistForm');
  const formBackdrop = document.getElementById('formBackdrop');
  const formClose = document.getElementById('formClose');
  const formStatus = document.getElementById('formStatus');
  const formSubmit = document.getElementById('formSubmit');
  const formTriggers = document.querySelectorAll('[data-action="open-waitlist"]');

  if (modal && form) {
    let prevFocus = null;
    function getFormFocusable() {
      return modal.querySelectorAll('input, select, textarea, button, a');
    }
    function openForm(e) {
      if (e) e.preventDefault();
      prevFocus = document.activeElement;
      // close drawer if open
      if (drawer && drawer.classList.contains('open')) {
        drawer.classList.remove('open');
        backdrop.classList.remove('open');
        document.body.classList.remove('drawer-open');
        if (burger) burger.setAttribute('aria-expanded', 'false');
      }
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('drawer-open'); // reuse scroll lock
      // update URL hash for deeplink (no scroll)
      if (location.hash !== '#waitlist') history.replaceState(null, '', '#waitlist');
      // focus first input
      setTimeout(() => form.querySelector('input[name="name"]')?.focus(), 100);
    }
    function closeForm() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('drawer-open');
      if (location.hash === '#waitlist') history.replaceState(null, '', location.pathname);
      formStatus.textContent = '';
      formStatus.className = 'form-status';
      formSubmit.disabled = false;
      if (prevFocus && prevFocus.focus) prevFocus.focus();
    }

    formTriggers.forEach(t => t.addEventListener('click', openForm));
    formClose.addEventListener('click', closeForm);
    formBackdrop.addEventListener('click', closeForm);

    // Esc to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) closeForm();
    });

    // Focus trap inside form
    form.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !modal.classList.contains('open')) return;
      const focusables = Array.from(getFormFocusable()).filter(el => !el.disabled && el.offsetParent !== null);
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    // Submit handler
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Native validation
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      formStatus.textContent = 'Sending…';
      formStatus.className = 'form-status';
      formSubmit.disabled = true;

      const fd = new FormData(form);
      const payload = {
        name: fd.get('name'),
        email: fd.get('email'),
        audience: fd.get('audience'),
        message: fd.get('message') || '',
        consent: fd.get('consent') === 'on',
        company: fd.get('company') || ''
      };

      try {
        const r = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await r.json().catch(() => ({}));
        if (!r.ok) {
          throw new Error(data.error || `HTTP ${r.status}`);
        }
        formStatus.textContent = "Thanks. We'll reach out within 48h.";
        formStatus.className = 'form-status success';
        form.reset();
        setTimeout(closeForm, 2400);
      } catch (err) {
        console.error('Waitlist submit failed:', err);
        formStatus.textContent = 'Submission failed. Please email marketing@vitacrypt.xyz';
        formStatus.className = 'form-status error';
        formSubmit.disabled = false;
      }
    });

    // Deeplink: #waitlist opens form on load
    if (location.hash === '#waitlist') {
      setTimeout(() => openForm(), 300);
    }
  }

  // M1: hero carousel dots
  const sideStack = document.querySelector('.hero-stage .side-stack');
  const heroDots = document.querySelectorAll('#heroDots .dot');
  if (sideStack && heroDots.length) {
    let raf = 0;
    sideStack.addEventListener('scroll', () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const cards = sideStack.querySelectorAll('.hero-card');
        if (!cards.length) return;
        const center = sideStack.scrollLeft + sideStack.clientWidth / 2;
        let bestIdx = 0, bestDist = Infinity;
        cards.forEach((c, i) => {
          const cardCenter = c.offsetLeft + c.offsetWidth / 2;
          const d = Math.abs(cardCenter - center);
          if (d < bestDist) { bestDist = d; bestIdx = i; }
        });
        heroDots.forEach((d, i) => d.classList.toggle('active', i === bestIdx));
      });
    }, { passive: true });
  }

  // M4: pipeline swipe pauses autoplay
  const pipeBody = document.querySelector('.pipe-body');
  if (pipeBody) {
    let resumeTimer = null;
    const pauseAutoplay = () => {
      if (typeof autoplay !== 'undefined' && autoplay) {
        clearInterval(autoplay);
        autoplay = null;
      }
      if (resumeTimer) clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => {
        if (MOBILE_MQ.matches && typeof startAutoplay === 'function' && !autoplay) {
          startAutoplay();
        }
      }, PIPE_AUTOPLAY_PAUSE_MS);
    };
    pipeBody.addEventListener('touchstart', pauseAutoplay, { passive: true });
    pipeBody.addEventListener('scroll', pauseAutoplay, { passive: true });
  }

  // M6: progressive disclosure — insert "more / less" buttons
  document.querySelectorAll('.clamp-mob').forEach(el => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'more-btn';
    btn.textContent = 'more';
    btn.setAttribute('aria-expanded', 'false');
    btn.addEventListener('click', () => {
      const open = el.classList.toggle('open');
      btn.classList.toggle('open', open);
      btn.textContent = open ? 'less' : 'more';
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    el.insertAdjacentElement('afterend', btn);
  });

  // 5C.1: section-level progressive disclosure (data-mcollapse="Label")
  document.querySelectorAll('[data-mcollapse]').forEach(el => {
    const label = el.getAttribute('data-mcollapse');
    el.classList.add('m-collapse');
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'm-toggle';
    btn.setAttribute('aria-expanded', 'false');
    btn.innerHTML = '<span class="lbl"></span><span class="chev" aria-hidden="true">▾</span>';
    btn.querySelector('.lbl').textContent = label;
    btn.addEventListener('click', () => {
      const open = el.classList.toggle('m-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.querySelector('.lbl').textContent = open ? ('Hide ' + label.replace(/^(Show|See|The) /i, '').toLowerCase()) : label;
    });
    el.insertAdjacentElement('afterend', btn);
  });

  // M7: sticky section nav — active highlight on scroll, tap → smooth scroll
  const secNavBtns = document.querySelectorAll('.mob-secnav button');
  if (secNavBtns.length) {
    secNavBtns.forEach(b => {
      b.addEventListener('click', () => {
        const target = document.getElementById(b.dataset.target);
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    const secObs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          secNavBtns.forEach(b => b.classList.toggle('active', b.dataset.target === e.target.id));
        }
      });
    }, { rootMargin: '-40% 0px -50% 0px', threshold: 0 });
    secNavBtns.forEach(b => {
      const t = document.getElementById(b.dataset.target);
      if (t) secObs.observe(t);
    });
  }
})();

// ====================== PREMIUM ANIMATIONS (commit 4C — pruned in 5B.1) ======================
// E1 heartbeat tempo, E3 hero typewriter, A1 dissolve cap, A2 living waveform —
// removed per AI-slop audit (Phase 1.5). Kept: A3 scanline (via revealObs),
// A7 odometer (via revealObs).

// ====================== DESKTOP POLISH (commit 4D) ======================

const DESKTOP_MQ = matchMedia('(min-width: 1024px) and (hover: hover)');

// A4: magnetic cursor on .btn-glow
(function magneticCTA(){
  if (RM) return;
  const R = 60, MAX = 7;           // capture radius beyond button, max px pull
  const btns = Array.from(document.querySelectorAll('.btn-glow'));
  if (!btns.length) return;
  let active = new Set();
  let ticking = false, lastE = null;
  function reset(btn){ btn.style.removeProperty('--mag-x'); btn.style.removeProperty('--mag-y'); }
  function process(){
    ticking = false;
    if (!lastE || !DESKTOP_MQ.matches) return;
    const e = lastE;
    for (const btn of btns){
      // skip offscreen/hidden buttons (e.g. modal CTA, drawer CTA when closed)
      if (btn.offsetParent === null) { if (active.has(btn)) { reset(btn); active.delete(btn); } continue; }
      const r = btn.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2);
      const dy = e.clientY - (r.top + r.height / 2);
      const maxR = Math.max(r.width, r.height) / 2 + R;
      if (Math.hypot(dx, dy) > maxR) {
        if (active.has(btn)) { reset(btn); active.delete(btn); }
      } else {
        const k = Math.min(1, (maxR - Math.hypot(dx, dy)) / maxR) * MAX;
        btn.style.setProperty('--mag-x', (dx / maxR * k).toFixed(2) + 'px');
        btn.style.setProperty('--mag-y', (dy / maxR * k).toFixed(2) + 'px');
        active.add(btn);
      }
    }
  }
  // single delegated listener; rAF-throttled; reads rects only inside the frame
  window.addEventListener('mousemove', (e) => {
    lastE = e;
    if (!ticking) { ticking = true; requestAnimationFrame(process); }
  }, { passive: true });
})();

// A5: hue-shift on scoped decorative elements (desktop scroll-bound)
(function hueShift(){
  if (RM) return;
  let raf = 0;
  function update(){
    raf = 0;
    if (!DESKTOP_MQ.matches) {
      root.style.setProperty('--accent-shift', '0deg');
      return;
    }
    const max = document.documentElement.scrollHeight - window.innerHeight;
    if (max <= 0) return;
    const t = Math.max(0, Math.min(1, window.scrollY / max));
    const shift = (t * 14).toFixed(1) + 'deg'; // 0 → 14deg sweep
    root.style.setProperty('--accent-shift', shift);
  }
  window.addEventListener('scroll', () => {
    if (raf) return;
    raf = requestAnimationFrame(update);
  }, { passive: true });
  update();
})();

// E2: theme-toggle scramble overlay
</script>

</body>
</html>
